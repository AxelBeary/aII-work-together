{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aII-work-together/contracts/event-v1.schema.json",
  "title": "Event v1",
  "description": "append-only 事件。这是账本的唯一真相：卡片状态、comments、executions、checklist、软删除全部由事件折叠得出。hash = sha256(prev + canonical(data))[:16]，prev 指向同卡上一条。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "task_id",
    "type",
    "at",
    "actor",
    "payload",
    "prev_hash",
    "hash"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "同卡内单调递增（AUTOINCREMENT）。增量拉取的游标：?since=seq。"
    },
    "task_id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "created",
        "claim",
        "heartbeat",
        "release",
        "block",
        "cancel",
        "submit",
        "verify",
        "review",
        "human",
        "reclaim",
        "retry_grant",
        "budget_set",
        "edit",
        "adopt",
        "comment",
        "comment-delivered",
        "execution-open",
        "execution-activity",
        "execution-close",
        "checklist-add",
        "checklist-check",
        "checklist-uncheck",
        "branch-set",
        "trash",
        "restore",
        "schedule-queued",
        "schedule-consumed",
        "schedule-skipped"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "at_ms": {
      "type": "integer"
    },
    "actor": {
      "enum": [
        "agent",
        "review",
        "human",
        "system"
      ]
    },
    "seat": {
      "type": [
        "string",
        "null"
      ]
    },
    "epoch": {
      "type": [
        "integer",
        "null"
      ],
      "description": "写路径必须带；旧事件为 null（不回填）"
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "写路径幂等键。同 (card_id, key) 重放必须返回原事件。实现：唯一索引 + INSERT OR IGNORE 后回读。"
    },
    "payload": {
      "type": "object",
      "description": "事件体。按 type 各有形状：execution-close 带 outcome/error/report；checklist-check 带 item_id/note；comment 带 body/thread_id。"
    },
    "prev_hash": {
      "type": [
        "string",
        "null"
      ],
      "description": "同卡上一条的 hash；首条为 null"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "sha256(prev + json.dumps(data, sort_keys=True))[:16]，与 storage.py::_hash 一致。"
    }
  },
  "example": {
    "seq": 42,
    "task_id": "C1019-cd02",
    "type": "execution-open",
    "at": "2026-11-19T20:00:00+08:00",
    "at_ms": 1795000000000,
    "actor": "agent",
    "seat": "w1",
    "epoch": 3,
    "idempotency_key": "exec-open:C1019-cd02:1",
    "payload": {
      "execution_id": "e-001",
      "session_id": "ses_x",
      "trigger": "manual"
    },
    "prev_hash": "a1b2c3d4e5f60718",
    "hash": "0f1e2d3c4b5a6978"
  }
}