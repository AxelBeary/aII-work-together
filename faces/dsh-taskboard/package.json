{
  "name": "dsh-taskboard",
  "version": "0.11.0-kernel.1",
  "description": "DSH 任务看板（内核适配版）：界面沿用 taskboard 原版，账本换成 aII-work-together 事件流内核",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  }
}